{
  "name": "Extractor de Transcripciones YT",
  "short_name": "YT Transcripciones",
  "description": "Extrae y estructura transcripciones de YouTube con historial local y sincronizacion en nube.",
  "start_url": "/index.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#e2e8f0",
  "theme_color": "#dc2626",
